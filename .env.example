# Copy to .env.local and fill in. Never commit real values.
# Supabase project (ca-central-1). Get these from the Supabase dashboard:
#   Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to "wall" on the Raspberry Pi so the app boots straight to the
# wall screen and skips the phone layout. On phones/computers leave this unset.
VITE_DEVICE_MODE=

# Weather: Edmonton. Open-Meteo needs no key; this is the location only.
VITE_WEATHER_LAT=53.5461
VITE_WEATHER_LON=-113.4938

# --- Raspberry Pi only ---
# The wall display scheduler (pi/display-agent.mjs) signs in with the wall's
# own family account to read the on/off schedule set from the phone app.
# Leave blank on phones/computers. Never commit real values.
WALL_EMAIL=
WALL_PASSWORD=
