# Copy to .env.local and fill in. Never commit real values.
# Supabase project (ca-central-1). Get these from the Supabase dashboard:
#   Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to "wall" on the Raspberry Pi so the app boots straight to the
# wall screen and skips the phone layout. On phones/computers leave this unset.
VITE_DEVICE_MODE=

# Weather: Edmonton. Open-Meteo needs no key; this is the location only.
VITE_WEATHER_LAT=53.5461
VITE_WEATHER_LON=-113.4938

# Wall only: the public address of the phone app, used for the "scan to add
# groceries" QR code on the wall (the wall itself runs on localhost).
VITE_PUBLIC_URL=

# --- Raspberry Pi only ---
# The wall display scheduler (pi/display-agent.mjs) signs in with the wall's
# own family account to read the on/off schedule set from the phone app.
# Leave blank on phones/computers. Never commit real values.
WALL_EMAIL=
WALL_PASSWORD=
# Optional backup (pi/api-watchdog.mjs): a Supabase personal access token
# (supabase.com/dashboard/account/tokens) so the Pi can restart the project if
# its API jams for 5+ minutes. It can manage your whole Supabase account: keep
# it only in the Pi's .env.local.
SUPABASE_ACCESS_TOKEN=

# Photos: the wall reads them from the home NAS via the local photo agent
# (pi/photos-agent.mjs). Set this in the WALL build only; leave unset elsewhere
# so no phone or the public site tries to reach it. See pi/README.md.
VITE_PHOTO_AGENT_URL=

# Smart home: the wall controls Home Assistant on the LAN. Set these in the WALL
# build only (a public HTTPS page can't reach a local device). Nest/Google
# devices come in through Home Assistant's Nest integration. See pi/README.md.
VITE_HA_URL=
VITE_HA_TOKEN=
